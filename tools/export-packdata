#!/usr/bin/env python3
"""Export what NEI shows (items, recipes, block colours) from our own client into brain/packdata.

Run once per version of the pack; takes about a quarter of an hour. Needs `tools/client setup` done, the mod
built, and a server the client may join (it joins as "Exporter", who has to be on the whitelist).

  tools/export-packdata [--join HOST:PORT] [--out DIR]
  tools/export-packdata --only icons [--join HOST:PORT] [--out DIR]

The game is started twice: once in Chinese for everything, once in English for the names only, because some
mods fix their names when the game starts. The first start also draws every item's icon (icons/).

--only icons draws the icons again for the items.jsonl that is already in DIR and touches nothing else there
(two minutes, most of it the game starting).
"""
import glob
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CLIENT = os.path.join(ROOT, "tools", "client")
WORK = os.path.join(ROOT, "client", "export")
MODS = os.path.join(ROOT, "client", "instance", ".minecraft", "mods")
PIDFILE = os.path.join(ROOT, "client", "client.pid")


def opt(flag, default):
    argv = sys.argv[1:]
    return argv[argv.index(flag) + 1] if flag in argv else default


def running():
    try:
        os.kill(int(open(PIDFILE).read()), 0)
        return True
    except (OSError, ValueError):
        return False


def run_client(args, limit_minutes):
    for mark in ("export.ok", "export.failed"):
        path = os.path.join(WORK, mark)
        if os.path.exists(path):
            os.remove(path)
    subprocess.run([CLIENT, "start"] + args, check=True)
    deadline = time.time() + limit_minutes * 60
    while running():
        if time.time() > deadline:
            subprocess.run([CLIENT, "stop"])
            raise SystemExit("the client did not finish in %d minutes; see client/client.log" % limit_minutes)
        time.sleep(5)
    if not os.path.exists(os.path.join(WORK, "export.ok")):
        raise SystemExit("the client closed without finishing the export; see client/client.log")


def read_lines(path):
    with open(path, encoding="utf8") as f:
        return [json.loads(line) for line in f if line.strip()]


def write_lines(path, rows):
    with open(path + ".part", "w", encoding="utf8") as f:
        for row in rows:
            f.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
    os.replace(path + ".part", path)


def items_sha1(path):
    """What icons.json calls itemsSha1: the id and damage value of every line, in order."""
    h = hashlib.sha1()
    with open(path, encoding="utf8") as f:
        for line in f.read().split("\n")[:-1]:
            try:
                row = json.loads(line)
                h.update(("%s/%d\n" % (row["id"], row["meta"])).encode("utf8"))
            except (ValueError, KeyError, TypeError):
                h.update(b"/0\n")
    return h.hexdigest()


def icons_drawn(items):
    """icons.json of the working directory, when it is there and is about exactly these items."""
    try:
        info = json.load(open(os.path.join(WORK, "icons", "icons.json"), encoding="utf8"))
    except (OSError, ValueError):
        return None
    if info.get("itemsSha1") != items_sha1(items):
        return None
    if any(not os.path.exists(os.path.join(WORK, "icons", name)) for name in info["files"]):
        return None
    return info


def draw_icons(join):
    run_client(["--lang", "zh_CN", "-D", "aiplayer.export=" + WORK, "-D", "aiplayer.export.only=icons",
                "-D", "aiplayer.export.join=" + join, "-D", "fml.readTimeout=180"], 20)


def publish_icons(out):
    """Put the icons next to the items.jsonl they belong to, or take away icons that belong to another one."""
    info = icons_drawn(os.path.join(out, "items.jsonl"))
    dest = os.path.join(out, "icons")
    meta_path = os.path.join(out, "meta.json")
    meta = json.load(open(meta_path, encoding="utf8")) if os.path.exists(meta_path) else {}
    if info is None:
        # Icons are found by line number, so the ones of another items.jsonl would be the wrong pictures.
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        meta.pop("icons", None)
    else:
        fresh = dest + ".part"
        if os.path.isdir(fresh):
            shutil.rmtree(fresh)
        os.makedirs(fresh)
        for name in info["files"] + ["icons.json"]:
            shutil.copy2(os.path.join(WORK, "icons", name), os.path.join(fresh, name))
        if os.path.isdir(dest):
            os.rename(dest, dest + ".old")
        os.rename(fresh, dest)
        shutil.rmtree(dest + ".old", ignore_errors=True)
        meta["icons"] = {"format": info["format"], "generatedAt": info["generatedAt"], "cell": info["cell"],
                         "icons": info["count"], "sheets": len(info["files"]), "missing": len(info["missing"]),
                         "seconds": info["seconds"]}
    with open(meta_path + ".part", "w", encoding="utf8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=1)
    os.replace(meta_path + ".part", meta_path)
    return info


def install_mod():
    jars = [j for j in sorted(glob.glob(os.path.join(ROOT, "mod", "build", "libs", "*.jar")), key=os.path.getmtime)
            if not j.endswith(("-dev.jar", "-sources.jar", "-javadoc.jar"))]
    if not jars:
        raise SystemExit("build the mod first (tools/gradle build)")
    for old in glob.glob(os.path.join(MODS, "aiplayer-*.jar")):
        os.remove(old)
    shutil.copy2(jars[-1], MODS)
    os.makedirs(WORK, exist_ok=True)


def only_icons(join, out):
    listed = os.path.join(out, "items.jsonl")
    if not os.path.exists(listed):
        raise SystemExit("no items.jsonl in %s; run the whole export first" % out)
    install_mod()
    # The game draws what the working directory lists; that has to be the list the icons will sit next to.
    work = os.path.join(WORK, "items.jsonl")
    if not os.path.exists(work) or items_sha1(work) != items_sha1(listed):
        shutil.copy2(listed, work)
    t0 = time.time()
    draw_icons(join)
    info = publish_icons(out)
    if info is None:
        raise SystemExit("the client finished but left no icons; see client/client.log")
    print("done in %d s: %d icons on %d sheets, %d empty or failed (%s s of drawing)"
          % (time.time() - t0, info["count"], len(info["files"]), len(info["missing"]), info["seconds"]))


def main():
    join = opt("--join", "127.0.0.1:10186")
    out = opt("--out", os.path.join(ROOT, "brain", "packdata"))
    only = opt("--only", None)
    if only not in (None, "icons"):
        raise SystemExit("--only takes: icons")
    if running():
        raise SystemExit("a client is already running (tools/client stop)")
    if only == "icons":
        only_icons(join, out)
        return
    install_mod()

    t0 = time.time()
    print("1/2 everything, in Chinese")
    # The export joins by itself once the title screen is up; the game's own --server argument is unreliable here.
    full = ["--lang", "zh_CN", "-D", "aiplayer.export=" + WORK, "-D", "aiplayer.export.join=" + join,
            "-D", "fml.readTimeout=180"]
    try:
        run_client(full, 30)
    except SystemExit as first:
        print("first attempt failed (%s), trying once more" % first)
        run_client(full, 30)
    print("2/2 names, in English")
    run_client(["--lang", "en_US", "-D", "aiplayer.export=" + WORK, "-D", "aiplayer.export.only=names"], 15)

    english = {(r["id"], r["meta"]): r["name"] for r in read_lines(os.path.join(WORK, "names-en_US.jsonl"))}
    for name in ("items.jsonl", "blocks.jsonl"):
        rows = read_lines(os.path.join(WORK, name))
        for row in rows:
            en = english.get((row["id"], row["meta"]))
            if en and en != row["name"]:
                row["en"] = en
        write_lines(os.path.join(WORK, name), rows)

    os.makedirs(out, exist_ok=True)
    names = ["items.jsonl", "blocks.jsonl", "recipes.jsonl", "handlers.json"]
    for extra in ("structures.jsonl", "carving.jsonl"):
        if os.path.exists(os.path.join(WORK, extra)):
            names.append(extra)
    for name in names:
        shutil.copy2(os.path.join(WORK, name), os.path.join(out, name + ".part"))
        os.replace(os.path.join(out, name + ".part"), os.path.join(out, name))
    meta_path = os.path.join(out, "meta.json")
    meta = json.load(open(meta_path, encoding="utf8")) if os.path.exists(meta_path) else {}
    nei = json.load(open(os.path.join(WORK, "meta.json"), encoding="utf8"))["nei"]
    nei["english"] = sum(1 for _ in english)
    nei["blocks"] = len(read_lines(os.path.join(WORK, "blocks.jsonl")))
    meta["nei"] = nei
    with open(meta_path + ".part", "w", encoding="utf8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=1)
    os.replace(meta_path + ".part", meta_path)

    # The first start drew the icons after everything else. If that went wrong, once more on its own; if that
    # goes wrong too the export is still good, only without pictures.
    if icons_drawn(os.path.join(out, "items.jsonl")) is None:
        print("3/2 the icons did not get drawn with the rest, drawing them on their own")
        try:
            draw_icons(join)
        except SystemExit as failed:
            print("no icons this time (%s)" % failed)
    icons = publish_icons(out)
    print("done in %d s: %s" % (time.time() - t0, json.dumps(nei, ensure_ascii=False)))
    if icons is None:
        print("icons: none")
    else:
        print("icons: %d on %d sheets, %d empty or failed, %s s"
              % (icons["count"], len(icons["files"]), len(icons["missing"]), icons["seconds"]))


if __name__ == "__main__":
    main()
